@APP.route('/save_image', methods=['POST'])
def save_image():
    global trt_yolo, outputFrame, lock, DETECTOR, isCapturing

    def preprocess_green(image):
        return cv2.medianBlur(image[:, :, 1], 5)

    def preprocess_gray(image):
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
        equalized = clahe.apply(gray)
        mask = gray < 200
        denoised = cv2.medianBlur(equalized, 5)
        denoised[~mask] = 0
        return denoised

    if not isCapturing:
        return "Could not save!"

    json_data = request.get_json() or {}
    filename = "cap_206698_2025-04-24_18-30-58_f070_pan0.jpg"
    os.makedirs(os.path.dirname(filename), exist_ok=True)
    green_annotated = filename.replace(".jpg", "_green.jpg")
    gray_annotated = filename.replace(".jpg", "_gray.jpg")

    with lock:
        if outputFrame is None:
            return "No frame available"
        focus_score = DETECTOR.check_focus(outputFrame) if DETECTOR else 0.6
        if focus_score < 0.5:
            auto_focus()
            return "Retrying focus"

        cv2.imwrite(filename, outputFrame.bgr, [cv2.IMWRITE_JPEG_QUALITY, 100])
        results = {"green": {"count": 0, "avg_prom": 0}, "gray": {"count": 0, "avg_prom": 0}}
        min_box_size, max_box_size = 5, 150

        for method, preprocess in [("green", preprocess_green), ("gray", preprocess_gray)]:
            frame = outputFrame.bgr.copy()
            enhanced = preprocess(frame)
            if len(enhanced.shape) == 2:
                enhanced = cv2.cvtColor(enhanced, cv2.COLOR_GRAY2BGR)
            try:
                res = trt_yolo.predict(enhanced, conf=0.2, imgsz=224, iou=0.6)[0]
                prom_sum = 0
                prom_list = []
                csv_row = []

                if res.boxes:
                    for box in res.boxes:
                        x1, y1, x2, y2 = map(int, box.xyxy[0].tolist())
                        if y2 > y1 and x2 > x1 and min_box_size < (x2 - x1) < max_box_size and min_box_size < (y2 - y1) < max_box_size:
                            cap_box = cv2.medianBlur(frame[(y1-10):(y2+10), (x1-10):(x2+10), 1], 5)
                            _, std = cv2.meanStdDev(cap_box)
                            prom = std[0][0]
                            prom_sum += prom
                            prom_list.append(prom)
                            csv_row.extend(((x1 + x2) // 2, (y1 + y2) // 2))
                            cv2.rectangle(frame, (x1-10, y1-10), (x2+10, y2+10), (0, 255, 0), 2)
                            cv2.putText(frame, f"Prom: {prom:.2f}", (x1, y1-10), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 1)

                    if prom_list:
                        avg_prom = prom_sum / len(prom_list)
                        results[method]["count"] = len(prom_list)
                        results[method]["avg_prom"] = avg_prom
                        cv2.putText(frame, f"Caps: {len(prom_list)}, Avg: {avg_prom:.2f}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
                        cv2.imwrite(green_annotated if method == "green" else gray_annotated, frame)
                        if len(prom_list) >= 2:
                            scan_uuid = request.cookies.get("scan_uuid", str(uuid.uuid4()))
                            csv_path = f"static/captured_pics/{scan_uuid}/{scan_uuid}_{method}.csv"
                            os.makedirs(os.path.dirname(csv_path), exist_ok=True)
                            with open(csv_path, 'a') as f:
                                csv.writer(f).writerow(csv_row + [f"ap_{avg_prom:.2f}"])
            except Exception as e:
                print(f"YOLO failed for {method}: {e}")
                continue

        green_score = results["green"]["count"] * results["green"]["avg_prom"]
        gray_score = results["gray"]["count"] * results["gray"]["avg_prom"]
        best_method = "green" if green_score >= gray_score else "gray"
        print(f"Best: {best_method}, Green: {results['green']['count']} caps, {results['green']['avg_prom']:.2f}, Gray: {results['gray']['count']} caps, {results['gray']['avg_prom']:.2f}")

        with open(filename.replace(".jpg", "_results.csv"), 'w') as f:
            writer = csv.writer(f)
            writer.writerow(["Method", "Count", "Avg Prominance"])
            writer.writerow(["Green", results["green"]["count"], results["green"]["avg_prom"]])
            writer.writerow(["Gray", results["gray"]["count"], results["gray"]["avg_prom"]])
            writer.writerow(["Best", best_method])

        save_metadata(filename, outputFrame.bgr.shape[1], outputFrame.bgr.shape[0])
        return f"Saved! Best: {best_method}"

